#include <iostream>
#include <vector>
#include <algorithm>

using namespace std;

int coinChangeMin(vector<int>& coins, int amount) {
    // Initialize DP array with amount + 1 (acting as a safe infinity value)
    vector<int> dp(amount + 1, amount + 1);
    
    // Base case: 0 coins needed to make an amount of 0
    dp[0] = 0;
    
    // Compute minimum coins for all amounts from 1 to 'amount'
    for (int i = 1; i <= amount; i++) {
        for (int coin : coins) {
            if (i - coin >= 0) {
                dp[i] = min(dp[i], dp[i - coin] + 1);
            }
        }
    }
    
    // If dp[amount] wasn't updated, it's impossible to form that amount
    return dp[amount] > amount ? -1 : dp[amount];
}

int main() {
    vector<int> coins = {1, 2, 5};
    int amount = 11;
    cout << "Minimum coins needed: " << coinChangeMin(coins, amount) << endl; // Output: 3 (5 + 5 + 1)
    return 0;
}
